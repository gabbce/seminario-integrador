                  "$ref": "administracion.openapi.json#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/referencias/aulas": {
      "get": {
        "summary": "Referencias de aulas para recorridos de reserva y consulta",
        "responses": {
          "200": {
            "description": "Resultado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Room"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "administracion.openapi.json#/components/schemas/Error"
